# ==============================================================================
# EchoBreak - Production Environment Variables
# Configure these in Netlify Site Settings -> Environment Variables
# ==============================================================================

# [REQUIRED FOR PRODUCTION PERSISTENCE] MongoDB Atlas connection URI
MONGO_URI=

# [REQUIRED FOR PRODUCTION SECURITY] Cryptographically secure secret key for JWT session tokens
JWT_SECRET=

# [REQUIRED FOR PRODUCTION ADMIN] Administrator credentials for admin portal access
ADMIN_EMAIL=
ADMIN_PASSWORD=
