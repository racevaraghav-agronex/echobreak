# ==============================================================================
# Database & Authentication (Required for Production Database & Security)
# ==============================================================================
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_secure_random_secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@echobreak.com
ADMIN_PASSWORD=your_secure_admin_password

# ==============================================================================
# Server & Client Configuration (Optional)
# ==============================================================================
CLIENT_ORIGIN=https://your-site.netlify.app
PORT=3000
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=https://your-site.netlify.app

# ==============================================================================
# Simulation & Acoustic Sensor Tuning (Optional)
# ==============================================================================
GEOCODING_SEARCH_RADIUS_KM=
VEHICLE_STATE_TTL_MS=
VEHICLE_UPDATE_INTERVAL_MS=
VITE_AUDIO_ANALYSIS_INTERVAL_MS=
VITE_AUDIO_CONFIDENCE_THRESHOLD=
VITE_AUDIO_DETECTION_COOLDOWN_MS=

# ==============================================================================
# Optional Commercial / Provider Overrides
# By default, EchoBreak uses the public OSRM demo server for routing, Nominatim
# for geocoding, and OpenStreetMap tiles. No API keys are required.
# Only provide these if swapping in a commercial provider (e.g. Mapbox, ORS).
# ==============================================================================
ROUTING_API_KEY=
GEOCODING_API_KEY=
VITE_MAP_STYLE_URL=
VITE_OSM_TILE_URL=
